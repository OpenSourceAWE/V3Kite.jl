#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

julia_extra_args=()
for arg in "$@"; do
    if [[ "$arg" == "--kaimon" ]]; then
        force_kaimon=true
    elif [[ "$arg" == "--nosysimage" ]]; then
        no_sysimage=true
    else
        julia_extra_args+=("$arg")
    fi
done

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi

julia_init='using Revise; function menu(); include("examples/menu.jl"); end; function menu2(); include("examples/menu2.jl"); end'

if [[ ${#julia_extra_args[@]} -gt 0 ]]; then
    JULIA_ARGS=("${julia_extra_args[@]}")
else
    JULIA_ARGS=(-i -e "$julia_init")
fi

if [[ -z "${no_sysimage:-}" ]] && test -f "bin/kps-image-${julia_major}.so"; then
    echo "Found system image!"
    julia --project -J "bin/kps-image-${julia_major}.so" "${JULIA_ARGS[@]}"
else
    julia --project "${JULIA_ARGS[@]}"
fi
