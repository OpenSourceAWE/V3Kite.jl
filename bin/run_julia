#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

print_usage() {
    cat <<EOF
Usage: bin/run_julia [options] [julia arguments...]

Start Julia for V3Kite, usually through the alias jl. Without Julia arguments
an interactive REPL starts that loads Revise (if available) and defines the
helpers menu() and menu2() for the examples.

Julia starts with the root project; menu() and menu2() activate the examples
project themselves. If bin/kps-image-<version>.so exists (see
bin/create_sys_image), it is used as system image. Threads default to
JULIA_NUM_THREADS=auto.

Options:
  -h, --help      show this help and exit
  --nosysimage    do not use the custom system image
  --psm           select the PSM project (sets V3KITE_PROJECT=psm)
  --beam          select the beam project (sets V3KITE_PROJECT=beam)
  --kaimon        accepted for compatibility, has no effect

All other arguments are passed to Julia instead of starting the REPL, e.g.
  bin/run_julia examples/v3kite.jl
  bin/run_julia -e 'println("ok")'
EOF
}

no_sysimage=false
julia_extra_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;
        --nosysimage)
            no_sysimage=true
            ;;
        --psm)
            export V3KITE_PROJECT=psm
            ;;
        --beam)
            export V3KITE_PROJECT=beam
            ;;
        --kaimon)
            ;;
        *)
            julia_extra_args+=("$1")
            ;;
    esac
    shift
done

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager
export JULIA_NUM_THREADS="${JULIA_NUM_THREADS:-auto}"

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi

julia_init='if Base.find_package("Revise") !== nothing; using Revise; end; function menu(); include("examples/menu.jl"); end; function menu2(); include("examples/menu2.jl"); end'

JULIA_ARGS=(--project)
if [[ $no_sysimage == "false" ]] && test -f "bin/kps-image-${julia_major}.so"; then
    echo "Found system image!"
    JULIA_ARGS+=(-J "bin/kps-image-${julia_major}.so")
fi

if [[ ${#julia_extra_args[@]} -gt 0 ]]; then
    JULIA_ARGS+=("${julia_extra_args[@]}")
else
    JULIA_ARGS+=(-i -e "$julia_init")
fi

julia "${JULIA_ARGS[@]}"
