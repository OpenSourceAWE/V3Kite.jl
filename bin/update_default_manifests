#!/bin/bash
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

set -eu

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."

usage() {
    cat <<'USAGE'
Usage: bin/update_default_manifests [-y] [--version <version>] [-h|--help]

Update every package to its latest version, separately for each Julia version
that has a tracked Manifest-v<version>.toml.default, and run the tests under each
of them. Only if all tests pass are the updated manifests copied to the tracked
defaults and committed; if any test fails, the script terminates and leaves the
defaults alone. Every one of those Julia versions has to be on the machine.

examples/ and test/ belong to the workspace of the main project, so one update
of the main project updates their packages too.

  -y          do not ask before updating, testing and committing
  --version <version>, --version +<version>
              update and commit only the default manifest of this Julia version,
              e.g. --version 1.13
  -h, --help  show this message
USAGE
}

assume_yes=false
only=""
while [ $# -gt 0 ]; do
    case "$1" in
        -y) assume_yes=true ;;
        --version)
            if [ $# -lt 2 ]; then
                echo "update_default_manifests: --version needs a value, e.g. --version 1.13" >&2
                exit 1
            fi
            only=${2#+}
            shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "update_default_manifests: unknown option $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

versions=()
for default in Manifest-v*.toml.default; do
    [ -f "$default" ] || continue
    version=${default#Manifest-v}
    version=${version%.toml.default}
    if [ -z "$only" ] || [ "$version" = "$only" ]; then
        versions+=("$version")
    fi
done
if [ ${#versions[@]} -eq 0 ]; then
    echo "update_default_manifests: no Manifest-v${only:-<version>}.toml.default here." >&2
    exit 1
fi

missing=()
for version in "${versions[@]}"; do
    on_machine=$(julia "+$version" --startup-file=no \
        -e 'print(VERSION.major, ".", VERSION.minor)' 2>/dev/null) || on_machine=""
    [ "$on_machine" = "$version" ] || missing+=("$version")
done
if [ ${#missing[@]} -gt 0 ]; then
    echo "update_default_manifests: no Julia ${missing[*]} on this machine;" \
         "juliaup add what is missing." >&2
    exit 1
fi

if ! $assume_yes; then
    read -r -p "Update every package, test and commit the defaults of ${versions[*]}? [y/N] " \
        reply
    case "$reply" in
        [yY]*) ;;
        *) echo "update_default_manifests: nothing updated."; exit 1 ;;
    esac
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

# Pkg is loaded before the project is activated: with --project, Julia 1.12 fails
# with a KeyError in the precompilation if the project depends on Pkg (test does)
# and its manifest is empty
for version in "${versions[@]}"; do
    manifest="Manifest-v$version.toml"
    # Pkg resolves into Manifest.toml unless the versioned name is already a file,
    # and a plain Manifest.toml would be used instead of the versioned one
    [ -f "$manifest" ] || cp "$manifest.default" "$manifest"
    rm -f Manifest.toml
    echo "update_default_manifests: updating and testing under Julia $version"
    julia "+$version" --startup-file=no -e \
        'using Pkg; Pkg.activate("."); Pkg.Registry.update(); Pkg.update()'
    if ! julia "+$version" --startup-file=no -e 'using Pkg; Pkg.activate("."); Pkg.test()'; then
        echo "update_default_manifests: tests failed under Julia $version;" \
             "the defaults are unchanged." >&2
        exit 1
    fi
done

defaults=()
for version in "${versions[@]}"; do
    cp "Manifest-v$version.toml" "Manifest-v$version.toml.default"
    defaults+=("Manifest-v$version.toml.default")
done

if git diff --quiet -- "${defaults[@]}"; then
    echo "update_default_manifests: the defaults are already up to date."
    exit 0
fi
git commit -m "Update the default manifests for Julia ${versions[*]}" -- "${defaults[@]}"
