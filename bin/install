#!/bin/bash
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

set -eu

start_dir=$(pwd -P)
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."

# Free disk space in the Julia depot that bin/install -i requires, in GB
MIN_FREE_GB=5

usage() {
    cat <<'USAGE'
Usage: bin/install [-y] [-i] [--update] [+<version> | --version <version>] [-h]

Make this checkout ready to use with the tested package versions:
  - check that the active Julia version is supported, i.e. that a
    Manifest-v<version>.toml.default exists for it
  - back up manifests that are no longer needed (*.bak): a plain Manifest.toml,
    a locally changed Manifest-v<version>.toml and the manifests in examples/
    and test/, which are not used because these folders belong to the
    workspace of the main project
  - copy Manifest-v<version>.toml.default to Manifest-v<version>.toml
  - copy each other tracked *.default file, e.g. .JETLSConfig.toml.default or
    examples/LocalPreferences.toml.default, to its name without .default if
    that file does not exist yet
  - resolve, instantiate and precompile the package and the examples

V3Kite specific:
  - before installing, the cached V3Kite model and settled-geometry files are
    deleted from V3Kite's scratchspace in the Julia depot (bin/delete_cache_files),
    because a cache written against an older package layout can fail to load
  - a stale system image bin/kps-image-<version>.so is deleted
  - the surface-resolved aero geometry of the beam kite (data/nf_aero_geometry.yaml,
    data/polars_neuralfoil/), which is not tracked by git, is generated afresh

Without parameters nothing is asked and nothing outside the repository is changed,
except the Julia depot as described above.
To update all packages to their latest versions use bin/update_default_manifest.

  -y, --yes   same as without parameters: never prompt (for automation)
  -i          interactive installation for end users: install or select a Julia
              version, add the alias jl for bin/run_julia, install Revise in the
              global environment if it is missing, optionally keep the cache
              files, precompile the test environment and run the tests
  --update    do not use the default manifest, update all packages of the main
              project to their latest versions instead (used by
              bin/create_sys_image --update)
  +<version>, --version <version>
              install for this Julia version, e.g. +1.13, instead of the active one;
              the juliaup default is not changed
  -h, --help  show this message

There is no docs environment in this repository, so -i does not offer to
precompile one.
USAGE
}

interactive=false
update=false
channel=""
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) ;;
        -i) interactive=true ;;
        --update) update=true ;;
        --version)
            if [ $# -lt 2 ]; then
                echo "bin/install: --version needs a value, e.g. --version 1.13" >&2
                exit 1
            fi
            channel=$2
            shift ;;
        +*) channel=${1#+} ;;
        -h|--help) usage; exit 0 ;;
        *) echo "bin/install: unknown option $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

# The Julia command; with +<version> juliaup starts that version for this run only
julia_cmd=(julia)
if [ -n "$channel" ]; then
    julia_cmd=(julia "+$channel")
fi

# The supported Julia versions are the ones with a tracked default manifest
supported=()
for default in Manifest-v*.toml.default; do
    [ -f "$default" ] || continue
    version=${default#Manifest-v}
    supported+=("${version%.toml.default}")
done
if [ ${#supported[@]} -eq 0 ]; then
    echo "bin/install: no Manifest-v<version>.toml.default in this repository." >&2
    exit 1
fi

# Print major.minor of the Julia that is used here, or nothing if there is none
active_julia() {
    "${julia_cmd[@]}" --startup-file=no -e 'print(VERSION.major, ".", VERSION.minor)' \
        2>/dev/null || true
}

is_supported() {
    local v
    for v in "${supported[@]}"; do
        [ "$v" = "$1" ] && return 0
    done
    return 1
}

# Let the user pick one option with an arrow-key menu from REPL.TerminalMenus.
# Arguments: the preselected option, the prompt, the options. Prints the chosen
# option; fails if the user cancels with q or Ctrl-C. The menu is drawn on stderr,
# so that the choice can be captured with $(...). Without a working Julia, e.g.
# juliaup without any installed version, it falls back to a plain prompt.
menu() {
    local default=$1 prompt=$2 reply option
    shift 2
    if [ -z "$(active_julia)" ]; then
        read -r -p "$prompt ($*) [$default] " reply
        reply=${reply:-$default}
        # Accept a prefix of an option, e.g. y for yes
        for option in "$@"; do
            if [[ $option == "$reply"* ]]; then
                printf '%s' "$option"
                return 0
            fi
        done
        return 1
    fi
    "${julia_cmd[@]}" --startup-file=no -e '
        using REPL.TerminalMenus
        default, prompt, options = ARGS[1], ARGS[2], ARGS[3:end]
        term = TerminalMenus.default_terminal(; out=stderr)
        cursor = something(findfirst(==(default), options), 1)
        choice = request(term, prompt, RadioMenu(options; pagesize=length(options)); cursor)
        choice == -1 && exit(1)
        print(options[choice])' "$default" "$prompt" "$@"
}

# Ask a yes/no question; the first argument is the default answer (y or n)
ask() {
    local default=yes
    [ "$1" = y ] || default=no
    [ "$(menu "$default" "$2" yes no)" = yes ]
}

delete_caches=true
install_revise=false
precompile_tests=false
run_tests=false

if $interactive; then
    if [ ! -t 0 ] || [ ! -t 2 ]; then
        echo "bin/install: -i needs an interactive terminal." >&2
        exit 1
    fi
    if ! command -v juliaup &> /dev/null; then
        echo "bin/install: juliaup is not installed. Please install it first:" >&2
        case "$(uname -s)" in
            Linux|Darwin)
                echo "  curl -fsSL https://install.julialang.org | sh" >&2 ;;
            MINGW*|MSYS*|CYGWIN*)
                echo "  winget install --name Julia --id 9NJNWW8PVKMN -e -s msstore" >&2 ;;
            *)
                echo "  see https://github.com/JuliaLang/juliaup" >&2 ;;
        esac
        exit 1
    fi

    depot=${JULIA_DEPOT_PATH:-$HOME/.julia}
    depot=${depot%%:*}
    [ -d "$depot" ] || depot=$HOME
    free_gb=$(( $(df -Pk "$depot" | awk 'NR==2 {print $4}') / 1024 / 1024 ))
    if [ "$free_gb" -lt "$MIN_FREE_GB" ]; then
        echo "bin/install: only ${free_gb} GB free in $depot, at least ${MIN_FREE_GB} GB needed." >&2
        exit 1
    fi

    # Supported Julia versions that juliaup has installed
    installed=()
    for v in "${supported[@]}"; do
        if [ "$(julia "+$v" --startup-file=no -e 'print(VERSION.major, ".", VERSION.minor)' \
                2>/dev/null)" = "$v" ]; then
            installed+=("$v")
        fi
    done

    if [ -n "$channel" ] && ! is_supported "$channel"; then
        echo "bin/install: Julia $channel is not supported, use one of: ${supported[*]}" >&2
        exit 1
    fi
    if [ -n "$channel" ] && [ "$(active_julia)" != "$channel" ]; then
        if ask y "Install Julia $channel with juliaup?"; then
            juliaup add "$channel"
        else
            echo "bin/install: Julia $channel is not installed, nothing installed." >&2
            exit 1
        fi
    elif [ ${#installed[@]} -eq 0 ]; then
        newest=${supported[${#supported[@]}-1]}
        echo "None of the supported Julia versions (${supported[*]}) is installed."
        if ask y "Install Julia $newest with juliaup?"; then
            juliaup add "$newest"
            installed=("$newest")
        else
            echo "bin/install: no supported Julia version, nothing installed." >&2
            exit 1
        fi
    fi

    active=$(active_julia)
    if [ -z "$channel" ] && { ! is_supported "$active" || [ ${#installed[@]} -gt 1 ]; }; then
        echo "Active Julia version: ${active:-none}. Supported and installed: ${installed[*]}"
        default=$active
        is_supported "$active" || default=${installed[${#installed[@]}-1]}
        if ! choice=$(menu "$default" "Julia version to use in this repository:" \
                "${installed[@]}"); then
            echo "bin/install: no Julia version selected, nothing installed." >&2
            exit 1
        fi
        if [ "$choice" != "$active" ]; then
            # Directory override: applies to this repository only
            juliaup override set "$choice"
        fi
    fi

    case "$(basename "${SHELL:-bash}")" in
        zsh)  rcfile=$HOME/.zshrc ;;
        fish) rcfile=$HOME/.config/fish/config.fish ;;
        *)    rcfile=$HOME/.bashrc ;;
    esac
    if ! grep -qs "alias jl=" "$rcfile"; then
        if ask y "Add the alias jl for bin/run_julia to $rcfile?"; then
            mkdir -p "$(dirname "$rcfile")"
            echo "alias jl='bin/run_julia'" >> "$rcfile"
            echo "Added the alias jl; it is active in new terminals."
        fi
    fi

    # The global environment is the default one, e.g. ~/.julia/environments/v1.12
    if ! "${julia_cmd[@]}" --startup-file=no -e 'using Pkg; Pkg.activate(; io=devnull)
            exit(haskey(Pkg.project().dependencies, "Revise") ? 0 : 1)' &> /dev/null &&
            ask y "Install Revise in the global environment of Julia $(active_julia)?"; then
        install_revise=true
    fi

    if ! ask y "Delete the cached V3Kite model and settled-geometry files?"; then
        delete_caches=false
    fi
    if ask n "Precompile the test environment?"; then
        precompile_tests=true
    fi
    if ask n "Run the tests after the installation?"; then
        run_tests=true
    fi
fi

version=$(active_julia)
if [ -z "$version" ]; then
    echo "bin/install: Julia ${channel:-} is not installed. Run bin/install -i to install it." >&2
    exit 1
fi
if ! is_supported "$version"; then
    echo "bin/install: Julia $version is not supported, use one of: ${supported[*]}" >&2
    echo "  Run bin/install -i to install or select a supported version." >&2
    exit 1
fi
echo "Installing for Julia $version..."

# A cache built against an older package layout can otherwise throw a deserialize
# error later (see bin/delete_cache_files for details)
if $delete_caches; then
    bin/delete_cache_files --yes
fi

# The system image is out of date once the packages change, until
# bin/create_sys_image is run again
if [ -f "bin/kps-image-$version.so" ]; then
    rm -f "bin/kps-image-$version.so"
    echo "Deleted stale system image bin/kps-image-$version.so"
fi

manifest="Manifest-v$version.toml"
# examples and test are part of the workspace and use the manifest of the
# main project, so manifests in these folders and a plain Manifest.toml are stale
for stale in Manifest.toml {examples,test}/Manifest*.toml; do
    [ -f "$stale" ] || continue
    mv "$stale" "$stale.bak"
    echo "Moved $stale to $stale.bak"
done
if [ -f "$manifest" ] && ! cmp -s "$manifest" "$manifest.default"; then
    mv "$manifest" "$manifest.bak"
    echo "Moved $manifest to $manifest.bak"
fi
if $update; then
    echo "--update selected: not using $manifest.default"
else
    cp "$manifest.default" "$manifest"
    echo "Copied $manifest.default to $manifest"
fi
# Keep local configuration files, only provide the default if there is none
while IFS= read -r default; do
    [[ $(basename "$default") == Manifest-v*.toml.default ]] && continue
    if [ ! -f "${default%.default}" ]; then
        cp "$default" "${default%.default}"
        echo "Copied $default to ${default%.default}"
    fi
done < <(git ls-files '*.default' 2>/dev/null || ls -A -- *.default .*.default 2>/dev/null)

# Make sure that the registry knows the versions of the manifest
"${julia_cmd[@]}" --startup-file=no -e 'using Pkg
    isempty(Pkg.Registry.reachable_registries()) ? Pkg.Registry.add("General") :
        Pkg.Registry.update()'

# Resolve (or update), instantiate and precompile the environment in the given folder
install_env() {
    local op=resolve
    if [ "$1" = . ] && $update; then
        op=update
    fi
    echo "Instantiating and precompiling the environment in $1 ..."
    "${julia_cmd[@]}" --startup-file=no --project="$1" -e \
        "using Pkg; Pkg.$op(); Pkg.instantiate(); Pkg.precompile(; strict=true)"
    # Pkg writes a plain Manifest.toml if there was no manifest, use the versioned name
    if [ -f Manifest.toml ]; then
        mv Manifest.toml "Manifest-v$version.toml"
    fi
}

install_env .
install_env examples
if $install_revise; then
    echo "Adding Revise to the global environment ..."
    "${julia_cmd[@]}" --startup-file=no -e 'using Pkg; Pkg.activate(); Pkg.add("Revise")'
fi
if $precompile_tests; then
    install_env test
fi

# The beam projects fly a sliced aero geometry that is not in git, so a checkout
# has none and an older one can hold a slice that predates the settings in the
# script below. Regenerating it here, with the caches already gone, is what
# makes a run after an install reproducible.
echo "Slicing the surface-resolved aero geometry..."
rm -rf data/nf_aero_geometry.yaml data/polars_neuralfoil
"${julia_cmd[@]}" --startup-file=no --project=examples examples/v3beam_aero_geometry.jl

if $run_tests; then
    "${julia_cmd[@]}" --startup-file=no --project -e 'using Pkg; Pkg.test()'
fi

# Ensure output directory exists for simulation logs
mkdir -p output
# Record the Julia version used for this install
"${julia_cmd[@]}" --startup-file=no -e 'print(VERSION)' > "install_version_$version.txt"

echo "Installation for Julia $version finished."

# Reached only without errors, because of set -e
if $interactive; then
    echo
    printf "\033[1;32mInstallation complete!\033[0m\n"
    echo
    echo "You can now launch Julia by typing"
    if [ "$start_dir" = "$PWD/bin" ]; then
        echo "cd .."
    elif [ "$start_dir" != "$PWD" ]; then
        echo "cd $PWD"
    fi
    echo "bin/run_julia"
    echo "and then explore the examples with:"
    echo "menu() or menu2()"
fi
